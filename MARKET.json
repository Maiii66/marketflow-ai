                "sourceCode": {
                  "code": "export const code = async (inputs) => {\n  const productName = inputs.productName;\n  const details = inputs.details;\n\n  const prompt = `You are an expert e-commerce copywriter. Write 3 platform-specific listing drafts for this product — never generic or robotic, each platform written fresh (not reworded copies).\n\nPRODUCT: ${productName}\nDETAILS: ${details}\n\nRULES: Use only the facts given above, never invent specs. No real brand names. No filler phrases like \"perfect for any occasion.\" If details are thin, write from the name alone and add a \"Note:\" line on what's missing.\n\nFormat exactly as:\n\n## ETSY TITLE\n(under 140 chars, warm/story tone)\n## ETSY TAGS\n(13 tags, comma-separated, lowercase)\n## ETSY DESCRIPTION\n(2-3 short paragraphs, personal tone, soft CTA)\n## AMAZON TITLE\n(keyword-first, factual)\n## AMAZON BULLETS\n(5 bullets, each starts with a CAPS benefit)\n## AMAZON BACKEND TERMS\n(comma-separated keywords, no title repeats)\n## SHOPIFY META TITLE\n(under 60 chars)\n## SHOPIFY META DESCRIPTION\n(under 160 chars, benefit + CTA)\n## SHOPIFY DESCRIPTION\n(3-4 paragraphs, brand storytelling, subheadings ok)`;\n\n  return { prompt };\n};",
                  "packageJson": "{}"
