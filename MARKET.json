                    },
                    "sampleData": {},
                    "sourceCode": {
                      "code": "export const code = async (inputs) => {\n  const text = inputs.aiOutput;\n\n  function extract(section, nextSections) {\n    const startTag = `## ${section}`;\n    const startIdx = text.indexOf(startTag);\n    if (startIdx === -1) return '';\n    const afterStart = startIdx + startTag.length;\n    \n    let endIdx = text.length;\n    for (const next of nextSections) {\n      const idx = text.indexOf(`## ${next}`, afterStart);\n      if (idx !== -1 && idx < endIdx) endIdx = idx;\n    }\n    return text.substring(afterStart, endIdx).trim();\n  }\n\n  const etsyTitle = extract('ETSY TITLE', ['ETSY TAGS']);\n  const etsyTags = extract('ETSY TAGS', ['ETSY DESCRIPTION']);\n  const etsyDescription = extract('ETSY DESCRIPTION', ['AMAZON TITLE']);\n  const amazonTitle = extract('AMAZON TITLE', ['AMAZON BULLETS']);\n  const amazonBullets = extract('AMAZON BULLETS', ['AMAZON BACKEND TERMS']);\n  const amazonBackendTerms = extract('AMAZON BACKEND TERMS', ['SHOPIFY META TITLE']);\n  const shopifyMetaTitle = extract('SHOPIFY META TITLE', ['SHOPIFY META DESCRIPTION']);\n  const shopifyMetaDescription = extract('SHOPIFY META DESCRIPTION', ['SHOPIFY DESCRIPTION']);\n  const shopifyDescription = extract('SHOPIFY DESCRIPTION', []);\n\n  const etsyDraft = `TITLE: ${etsyTitle}\\n\\nTAGS: ${etsyTags}\\n\\nDESCRIPTION:\\n${etsyDescription}`;\n  const amazonDraft = `TITLE: ${amazonTitle}\\n\\nBULLETS:\\n${amazonBullets}\\n\\nBACKEND TERMS: ${amazonBackendTerms}`;\n  const shopifyDraft = `META TITLE: ${shopifyMetaTitle}\\n\\nMETA DESCRIPTION: ${shopifyMetaDescription}\\n\\nDESCRIPTION:\\n${shopifyDescription}`;\n\n  return { etsyDraft, amazonDraft, shopifyDraft };\n};",
